# Copy this file to config.env and edit the values before running the pipeline.

# Repository and input paths
PROJECT_ROOT="/absolute/path/to/surf_2_volume"
INPUT_CIFTI="${PROJECT_ROOT}/data/input/CortexSubcortex_ColeAnticevic_NetPartition_wSubcorGSR_netassignments_LR.dlabel.nii"
TEMPLATE_T1="${PROJECT_ROOT}/data/input/tpl-MNI152NLin6Asym_res-01_T1w.nii.gz"

# Template subject
SUBJECT_ID="MNI152NLin6Asym"
SUBJECTS_DIR="${PROJECT_ROOT}/work/freesurfer_subjects"

# Atlas and surface settings
ATLAS_NAME="ColeAnticevic"
TARGET_DENSITY="164k"
GM_THRESHOLD="0.25"
RIBBON_BLUR_FWHM="2"
MERGE_PRIORITY="left-right-subcortical"

# The original workflow used 256 for all three options. In AFNI, -RL, -AP,
# and -IS add or cut planes symmetrically so the resulting volume has the
# requested number of slices in each anatomical direction.
ZERO_PAD_ENABLED="1"
ZERO_PAD_RL="256"
ZERO_PAD_AP="256"
ZERO_PAD_IS="256"

# Set to 0 to reuse an existing FreeSurfer reconstruction and SUMA directory.
RUN_RECON_ALL="1"

# Executables. Replace with absolute paths if they are not on PATH.
PYTHON_BIN="python3"
WB_COMMAND="wb_command"
RECON_ALL="recon-all"
MRI_SURF2SURF="mri_surf2surf"
SUMA_MAKE_SPEC="@SUMA_Make_Spec_FS"
SURF_TO_SURF="SurfToSurf"
SURF_TO_VOL_SPACKLE="@surf_to_vol_spackle"
THREED_ZEROPAD="3dZeropad"
THREED_CALC="3dcalc"
THREED_MERGE="3dmerge"
